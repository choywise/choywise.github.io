# Copy to .env for local development (never commit .env).
# On Netlify, set the same variables under Site configuration > Environment variables.

# Required: Anthropic API key used by the AI assistant functions.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model behind the assistant (default claude-sonnet-5-5).
# claude-haiku-4-5 is cheaper and faster; claude-opus-5-5 is the most capable.
AI_LAB_MODEL=claude-sonnet-5

# Local dev only: serve canned responses instead of calling the API
# (lets you work on the UI without spending tokens). Same as `npm run dev -- --mock`.
AI_LAB_MOCK=0
